{
  "name": "coffemanagement_desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "concurrently -n frontend,backend,electron \"vite\" \"node server/index.js\" \"wait-on http://localhost:5173 http://localhost:5000/health && electron .\"",
    "electron:build": "vite build && electron-builder --win --config",
    "server": "node server/index.js",
    "server:dev": "nodemon server/index.js",
    "db:init": "node server/db/init.js",
    "lint": "oxlint"
  },
  "build": {
    "appId": "com.brewtura.management",
    "productName": "Brewtura",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/brewtura_brand_logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.27.0",
    "pg": "^8.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^9.8.8",
    "concurrently": "^9.1.2",
    "electron": "^33.4.2",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.9",
    "oxlint": "^1.71.0",
    "postcss": "^7.0.39",
    "tailwindcss": "npm:@tailwindcss/postcss7-compat@^2.2.17",
    "vite": "^8.1.1",
    "wait-on": "^8.0.3"
  }
}
