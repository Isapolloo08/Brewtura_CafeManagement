PORT=5000
NODE_ENV=development

# Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=coffee_shop_db

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_coffee_shop_2026_change_in_production
JWT_EXPIRES_IN=24h

# Gmail Integration (Supplier Email Ingestion)
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/v1/gmail/callback

# SMS Integration (Supplier SMS via cloud gateway OR GSM modem / USB dongle)
#
# OPTION A - Semaphore Cloud (recommended, no hardware). Get an API key at
# https://semaphore.co (Philippines, ~₱0.30-0.40/SMS). When SEMAPHORE_API_KEY is
# set it is used automatically and the local bridge is ignored.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
# Optional: secret to guard the inbound webhook. Semaphore posts received SMS to
# /api/v1/sms/webhook?secret=... — set this in your Semaphore "receive" settings.
SEMAPHORE_WEBHOOK_SECRET=
# Optional override (defaults to https://api.semaphore.co/api/v4)
# SEMAPHORE_BASE_URL=

# OPTION B - Local GSM bridge (Python). The bridge (sms/bridge.py) talks to the
# modem over serial and exposes this HTTP API. Values must match what the bridge uses.
SMS_BRIDGE_URL=http://127.0.0.1:8008
SMS_BRIDGE_TOKEN=change_me
SMS_POLL_INTERVAL_MS=5000
